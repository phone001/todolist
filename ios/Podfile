# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# F-27(v1.23, 원격 푸시 알림): @react-native-firebase/app 은 기본(정적 라이브러리, use_frameworks! 미사용)
# 빌드에서 Firebase iOS SDK 를 정적 프레임워크로 강제해야 한다 — 그렇지 않으면 Firebase 의 일부
# Swift pod(예: FirebaseCoreInternal)가 modular header 요구사항 때문에 링크에 실패한다.
# 근거: `@react-native-firebase/app`(RNFBApp.podspec)의 `$RNFirebaseAsStaticFramework` 플래그.
$RNFirebaseAsStaticFramework = true

# F-27(v1.23): Firebase iOS SDK 는 내부적으로 `@import FirebaseCore;` 형태의 모듈 임포트를 사용한다.
# 정적 라이브러리(비-프레임워크) 빌드에서는 모듈맵이 없으면 "Module 'FirebaseCore' not found" 로
# 링크에 실패하므로 Firebase 관련 pod 에만 modular header 를 켠다. 전역 `use_modular_headers!` 는
# React Native 자체 pod(예: React-RCTAppDelegate 의 `ReactCommon` 모듈맵)와 충돌해 별도로 사용하지
# 않는다(react-native-firebase 공식 트러블슈팅 안내의 "특정 dependency 에만 지정" 방식 채택).
# 주의: `Firebase` 는 반드시 `Firebase/CoreOnly` 서브스펙으로 지정한다 — 서브스펙 없이 `pod 'Firebase'`
# 를 선언하면 기본 서브스펙(Analytics 포함)으로 해석되어 RNFBApp(P-76, 서버 없음·최소 범위)이
# 요구하지 않는 FirebaseAnalytics/GoogleAppMeasurement 가 불필요하게 추가 설치된다.
FIREBASE_MODULAR_HEADER_PODS = %w[
  Firebase/CoreOnly
  FirebaseCore
  FirebaseCoreExtension
  FirebaseCoreInternal
  FirebaseInstallations
  FirebaseMessaging
  GoogleDataTransport
  GoogleUtilities
  nanopb
  PromisesObjC
]

target 'TodayWhat' do
  config = use_native_modules!

  FIREBASE_MODULAR_HEADER_PODS.each { |name| pod name, :modular_headers => true }

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'TodayWhatTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
